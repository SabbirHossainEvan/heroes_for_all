{
  "name": "heroes-for-all-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "heroes-for-all"
  ],
  "scripts": {
    "dev": "npm --prefix ./heroes-for-all run dev",
    "build": "npm --prefix ./heroes-for-all run build",
    "start": "npm --prefix ./heroes-for-all run start",
    "lint": "npm --prefix ./heroes-for-all run lint",
    "db:push": "npm --prefix ./heroes-for-all run db:push",
    "db:generate": "npm --prefix ./heroes-for-all run db:generate",
    "db:migrate": "npm --prefix ./heroes-for-all run db:migrate",
    "db:reset": "npm --prefix ./heroes-for-all run db:reset"
  }
}
